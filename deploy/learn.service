[Unit]
Description=Learn — personal technical learning platform
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/learn
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/projects/learn/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8099 --proxy-headers
Restart=always
RestartSec=3
StandardOutput=append:/home/ubuntu/projects/learn/data/learn.log
StandardError=append:/home/ubuntu/projects/learn/data/learn.log

# The app needs Docker to run the code sandbox, nothing else privileged.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
